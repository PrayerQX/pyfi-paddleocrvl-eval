{
  "experiment": "exp1_direct_zeroshot",
  "purpose": "Direct image VQA baseline for a PaddleOCR-VL-compatible VLM endpoint.",
  "academic_controls": [
    "single pass",
    "no answer fallback",
    "no option-letter priors",
    "same prompt for every sample"
  ],
  "command": [
    "python",
    "-m",
    "finvl_eval.runner",
    "--dataset",
    "data/pyfi/pyfi_eval_301.jsonl",
    "--format",
    "jsonl",
    "--images-root",
    "data/pyfi",
    "--model",
    "openai-compatible-vlm",
    "--openai-model",
    "<paddleocr-vl-vlm-endpoint-model>",
    "--prompt-style",
    "direct",
    "--out",
    "runs/pyfi_exp1_direct_zeroshot_paddleocrvl.jsonl",
    "--require-image",
    "--progress-every",
    "25"
  ],
  "environment": {
    "OPENAI_API_KEY": "set at runtime",
    "OPENAI_BASE_URL": "set at runtime"
  }
}
